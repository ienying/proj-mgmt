# ============================================
# 生产环境配置模板
# 使用: cp .env.production.example ../.env.production
#       然后编辑 ../.env.production 填入实际值
# ============================================

# ============================================
# PostgreSQL (必填)
# ============================================
PG_USER=projmgmt
PG_PASSWORD=<在此填入强密码>
PG_DB=projmgmt
PG_PORT=5432

# ============================================
# JWT Secret (必填 — 生成方式: openssl rand -hex 32)
# ============================================
JWT_SECRET=<在此填入随机密钥>

# ============================================
# S3 / Object Storage (可选 — 用于文件上传)
# ============================================
COZE_BUCKET_ENDPOINT_URL=
COZE_BUCKET_NAME=
COZE_BUCKET_ACCESS_KEY_ID=
COZE_BUCKET_SECRET_ACCESS_KEY=

# ============================================
# App Config
# ============================================
COZE_PROJECT_ENV=PROD
PORT=5000
HOSTNAME=0.0.0.0

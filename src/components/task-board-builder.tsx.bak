"use client";
import { useState, useEffect, useCallback } from "react";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Checkbox } from "@/components/ui/checkbox";
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@/components/ui/select";
import { Plus, Trash2, Building2, FileText } from "lucide-react";
import { toast } from "sonner";
import type { FormColumn } from "./task-form-builder";

export interface BoardRecord {
  source_project_schema: string;
  source_project_name: string;
  source_table_code: string;
  source_record_id: string;
  source_label: string;
  source_data: Record<string, unknown>;
}
export interface ExtraColumn extends FormColumn { fillable_by?: string; }

interface Props {
  selectedProjects: string[]; onProjectsChange: (ids: string[]) => void;
  records: BoardRecord[]; onRecordsChange: (records: BoardRecord[]) => void;
  extraColumns: ExtraColumn[]; onExtraColumnsChange: (cols: ExtraColumn[]) => void;
}

const SUPPLEMENT_TYPES = [
  { code: "text", name: "文本", icon: FileText },
  { code: "select", name: "单选", icon: FileText },
  { code: "user", name: "用户", icon: FileText },
];
const MODULES = ["scope","schedule","quality","cost","collaboration","communication","risk","procurement","resource","document"];

export function TaskBoardBuilder({ selectedProjects, onProjectsChange, records, onRecordsChange, extraColumns, onExtraColumnsChange }: Props) {
  const [projects, setProjects] = useState<Array<{id:string;name:string;schema:string}>>([]);
  const [browseProjectId, setBrowseProjectId] = useState("");
  const [browseModule, setBrowseModule] = useState("");
  const [browseTable, setBrowseTable] = useState("");
  const [browseData, setBrowseData] = useState<Array<Record<string,unknown>>>([]);
  const [browseCols, setBrowseCols] = useState<Array<{name:string;type:string}>>([]);
  const [selectedIds, setSelectedIds] = useState<Set<string>>(new Set());
  const [moduleTables, setModuleTables] = useState<Array<{code:string;name:string}>>([]);
  const [loading, setLoading] = useState(false);

  useEffect(() => { fetch("/api/projects").then(r=>r.json()).then(d=>{setProjects((d.data||[]).map((p:any)=>({id:String(p.id),name:String(p.project_name),schema:String(p.project_schema||"")})));}).catch(()=>{}); }, []);

  useEffect(() => {
    if(!browseProjectId){setModuleTables([]);return;}
    fetch("/api/standards").then(r=>r.json()).then(d=>{
      const tables:Array<{code:string;name:string}>=[];
      for(const s of (d.data||[])){
        const mcs=s.module_type||[];
        if(browseModule&&browseModule!=="__all__"&&!mcs.includes(browseModule))continue;
        tables.push({code:s.table_code,name:s.table_name||s.table_code});
      }
      setModuleTables(tables);
    }).catch(()=>{});
  },[browseProjectId,browseModule]);

  useEffect(() => {
    if(!browseProjectId||!browseTable)return;
    const proj=projects.find(p=>p.id===browseProjectId);
    if(!proj?.schema)return;
    setLoading(true);
    fetch(`/api/project-data?projectSchema=${proj.schema}&tableCode=${browseTable}`).then(r=>r.json()).then(d=>{setBrowseData(d.data||[]);}).catch(()=>setBrowseData([]));
    fetch("/api/standards").then(r=>r.json()).then(d2=>{const def=(d2.data||[]).find((s:any)=>s.table_code===browseTable);setBrowseCols((def?.columns_config as any[])||[]);}).catch(()=>{});
    }).finally(() => setLoading(false));
  },[browseProjectId,browseTable,projects]);

  const addRecords = () => {
    const proj=projects.find(p=>p.id===browseProjectId);
    const nr:BoardRecord[]=[];
    for(const rec of browseData){
      if(selectedIds.has(String(rec.id))){
        const lc=browseCols[0]; const label=lc?String(rec[lc.name]||rec.id):String(rec.id);
        nr.push({source_project_schema:proj?.schema||"",source_project_name:proj?.name||"",source_table_code:browseTable,source_record_id:String(rec.id),source_label:`[${proj?.name||""}] ${label}`,source_data:rec as any});
      }
    }
    if(nr.length===0){toast.warning("请先勾选记录");return;}
    onRecordsChange([...records,...nr]); setSelectedIds(new Set()); toast.success(`已添加 ${nr.length} 条`);
  };
  const removeRecord = (i:number) => onRecordsChange(records.filter((_,j)=>j!==i));
  const addEC = (tc:string) => onExtraColumnsChange([...extraColumns,{name:"",type:tc,required:false,sort_order:extraColumns.length,options:tc==="select"?[]:undefined,fillable_by:"anyone"}]);
  const updateEC = (i:number,f:string,v:unknown) => {const nc=[...extraColumns];nc[i]={...nc[i],[f]:v};onExtraColumnsChange(nc);};
  const removeEC = (i:number) => onExtraColumnsChange(extraColumns.filter((_,j)=>j!==i));

  return (
    <div className="space-y-4">
      <div className="space-y-1.5">
        <Label className="text-xs font-medium text-gray-600">关联项目（可多选）</Label>
        <div className="flex flex-wrap gap-1.5">
          {projects.map(p => (
            <label key={p.id} className={`flex items-center gap-1.5 text-xs cursor-pointer px-2.5 py-1.5 rounded-lg border transition-colors ${selectedProjects.includes(p.id)?"border-blue-400 bg-blue-50 text-blue-700":"hover:bg-gray-50 text-gray-600"}`}>
              <Checkbox checked={selectedProjects.includes(p.id)} onCheckedChange={(c)=>{if(c)onProjectsChange([...selectedProjects,p.id]);else onProjectsChange(selectedProjects.filter(id=>id!==p.id));}} />
              <Building2 className="w-3 h-3" />{p.name}
            </label>
          ))}
        </div>
      </div>

      <div className="border rounded-xl overflow-hidden">
        <div className="bg-gray-50/80 border-b px-4 py-2.5 flex items-center gap-2 flex-wrap">
          <span className="text-xs font-medium text-gray-500 mr-1">浏览数据</span>
          <Select value={browseProjectId} onValueChange={v=>{setBrowseProjectId(v);setBrowseModule("");setBrowseTable("");setBrowseData([]);}} disabled={selectedProjects.length===0}>
            <SelectTrigger className="h-7 text-xs w-36 bg-white"><SelectValue placeholder="选择项目" /></SelectTrigger>
            <SelectContent>{projects.filter(p=>selectedProjects.includes(p.id)).map(p=><SelectItem key={p.id} value={p.id}>{p.name}</SelectItem>)}</SelectContent>
          </Select>
          <Select value={browseModule||"__all__"} onValueChange={v=>{setBrowseModule(v==="__all__"?"":v);setBrowseTable("");setBrowseData([]);}}>
            <SelectTrigger className="h-7 text-xs w-28 bg-white"><SelectValue placeholder="模块" /></SelectTrigger>
            <SelectContent><SelectItem value="__all__">全部模块</SelectItem>{MODULES.map(m=><SelectItem key={m} value={m}>{m}</SelectItem>)}</SelectContent>
          </Select>
          <Select value={browseTable} onValueChange={setBrowseTable}>
            <SelectTrigger className="h-7 text-xs w-40 bg-white"><SelectValue placeholder="选择表" /></SelectTrigger>
            <SelectContent>{moduleTables.map(t=><SelectItem key={t.code} value={t.code}>{t.name}</SelectItem>)}</SelectContent>
          </Select>
          {browseTable&&browseData.length>0&&(
            <Button size="sm" variant="default" className="h-7 text-xs bg-blue-600 hover:bg-blue-700 ml-auto" onClick={addRecords}><Plus className="w-3 h-3 mr-1" />加入已选 ({selectedIds.size})</Button>
          )}
        </div>
        <div className="max-h-64 overflow-y-auto">
          {loading?<div className="text-center py-12 text-gray-400 text-sm">加载中...</div>
          :browseTable&&browseData.length>0?(
            <table className="w-full text-xs"><thead className="bg-gray-50/50 sticky top-0"><tr>
              <th className="text-left px-3 py-2 font-medium text-gray-500 w-10">☐</th>
              {browseCols.slice(0,3).map(c=><th key={c.name} className="text-left px-3 py-2 font-medium text-gray-500">{c.name}</th>)}
              <th className="text-left px-3 py-2 font-medium text-gray-500 text-[10px]">来源</th>
            </tr></thead><tbody className="divide-y">
              {browseData.map(rec=>{const rid=String(rec.id);const chk=selectedIds.has(rid);return(
                <tr key={rid} className={`cursor-pointer transition-colors ${chk?"bg-blue-50/50":"hover:bg-gray-50"}`} onClick={()=>{const n=new Set(selectedIds);chk?n.delete(rid):n.add(rid);setSelectedIds(n);}}>
                  <td className="px-3 py-2"><Checkbox checked={chk} onCheckedChange={()=>{}} /></td>
                  {browseCols.slice(0,3).map(c=><td key={c.name} className="px-3 py-2 text-gray-700 truncate max-w-[200px]">{String(rec[c.name]||"")}</td>)}
                  <td className="px-3 py-2 text-gray-400">{projects.find(p=>p.id===browseProjectId)?.name||""}</td>
                </tr>
              );})}
            </tbody></table>
          ):browseProjectId&&browseTable?<div className="text-center py-12 text-gray-400 text-sm">该表无数据</div>
          :<div className="text-center py-12 text-gray-400 text-sm">{selectedProjects.length===0?"请先在上方勾选关联项目":"选择项目、模块、表以浏览数据"}</div>}
        </div>
      </div>

      <div className="space-y-2">
        <div className="flex items-center justify-between">
          <Label className="text-xs font-medium text-gray-600">已选记录（{records.length} 条）</Label>
          {records.length>0&&<Button variant="ghost" size="sm" className="h-6 text-xs text-red-400" onClick={()=>onRecordsChange([])}>清空全部</Button>}
        </div>
        {records.length===0?(
          <div className="text-center py-8 text-gray-400 text-sm border border-dashed rounded-xl">还没有记录，在上方浏览数据中勾选并点击"加入已选"</div>
        ):(
          <div className="border rounded-xl overflow-hidden"><table className="w-full text-xs"><thead className="bg-gray-50"><tr>
            <th className="text-left px-3 py-2 font-medium text-gray-500 w-8">#</th>
            <th className="text-left px-3 py-2 font-medium text-gray-500">记录</th>
            {extraColumns.map((col,i)=>(<th key={i} className="text-left px-3 py-2 font-medium text-gray-500 group relative"><div className="flex items-center gap-1"><span>{col.name||`列${i+1}`}</span><button onClick={()=>removeEC(i)} className="opacity-0 group-hover:opacity-100 text-red-300 hover:text-red-500 ml-1">×</button></div></th>))}
            <th className="w-10"></th>
          </tr></thead><tbody className="divide-y">
            {records.map((rec,idx)=>(<tr key={idx} className="hover:bg-gray-50"><td className="px-3 py-2 text-gray-400">{idx+1}</td><td className="px-3 py-2 text-gray-700 truncate max-w-[250px]" title={rec.source_label}>{rec.source_label}</td>{extraColumns.map((_,ci)=>(<td key={ci} className="px-2 py-2"><Input placeholder="-" className="h-6 text-xs border-gray-200" /></td>))}<td className="px-1"><button onClick={()=>removeRecord(idx)} className="text-red-300 hover:text-red-500"><Trash2 className="w-3 h-3" /></button></td></tr>))}
          </tbody></table></div>
        )}
        <div className="flex items-center gap-2 flex-wrap pt-1">
          <span className="text-xs text-gray-400">补充列：</span>
          {extraColumns.map((col,idx)=>(<div key={idx} className="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border bg-white text-xs"><Input value={col.name} onChange={(e)=>updateEC(idx,"name",e.target.value)} placeholder="列名" className="h-6 text-xs w-20 border-0 p-0 focus:ring-0" /><span className="text-[11px] text-gray-400">{SUPPLEMENT_TYPES.find(t=>t.code===col.type)?.name||col.type}</span><button onClick={()=>removeEC(idx)} className="text-red-400 hover:text-red-600">×</button></div>))}
          {SUPPLEMENT_TYPES.map(ft=>(<button key={ft.code} onClick={()=>addEC(ft.code)} className="flex items-center gap-1 px-2.5 py-1.5 rounded-lg border border-dashed border-gray-300 text-xs text-gray-500 hover:border-gray-400 hover:bg-gray-50"><Plus className="w-3 h-3" /> {ft.name}</button>))}
        </div>
      </div>
    </div>
  );
}
